# StockVision Backend Configuration
# Copy this file to .env and adjust values as needed.

# --- App ---
APP_NAME=StockVision
APP_ENV=demo
DEBUG=true

# --- Security ---
# Generate a real secret for production: openssl rand -hex 32
JWT_SECRET_KEY=change-this-super-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Database ---
# Demo mode uses local SQLite. For production, point this at SQL Server/Postgres/MySQL
# e.g. mssql+pyodbc://user:pass@host/db?driver=ODBC+Driver+17+for+SQL+Server
DATABASE_URL=sqlite:///../data/stockvision.db

# --- Data Source Mode ---
# "demo" = local SQLite generated data
# "estock" = future real e-Stock / SQL Server adapter
DATA_SOURCE_MODE=demo
